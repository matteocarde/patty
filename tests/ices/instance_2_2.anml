instance Treatment t0, t1, t2;
instance Item i0, i1;

item_id(i0) := 0;
item_id(i1) := 1;
consecutive(t0, t1) := true;
consecutive(t1, t2) := true;
consecutive(t0, t0) := false;
consecutive(t0, t2) := false;
consecutive(t1, t0) := false;
consecutive(t1, t1) := false;
consecutive(t2, t0) := false;
consecutive(t2, t1) := false;
consecutive(t2, t2) := false;

[start] busy := false;
[start] treated(i0, t0) := false;
[start] treated(i0, t1) := false;
[start] treated(i0, t2) := false;
[start] started(i0, t0) := false;
[start] started(i0, t1) := false;
[start] started(i0, t2) := true;
[start] ready(i0, t0) := true;
[start] ready(i0, t1) := false;
[start] ready(i0, t2) := false;
[start] treated(i1, t0) := false;
[start] treated(i1, t1) := false;
[start] treated(i1, t2) := false;
[start] started(i1, t0) := false;
[start] started(i1, t1) := false;
[start] started(i1, t2) := true;
[start] ready(i1, t0) := true;
[start] ready(i1, t1) := false;
[start] ready(i1, t2) := false;
[start] counter(t0) := 0;
[start] counter(t1) := 0;
[start] counter(t2) := 0;
[start + 10] counter(t2) := 0;
[end - 10] counter(t2) := 0;

[start + 10, end] treated(i0, t1) == false;

[end] treated(i0, t0) == true;
[end] treated(i0, t1) == true;
[end] treated(i1, t0) == true;
[end] treated(i1, t1) == true;
[end] treated(i1, t1) == false;
[end] counter(t2) == 5;
[end] counter(t2) > 10 + counter(t1);
[end] counter(t2) < 10 + counter(t1);
[end] counter(t2) == 10 + counter(t1);
[end] counter(t2) == (10 + counter(t1))*5;
[end] counter(t2) != (10 + counter(t1))*5;
